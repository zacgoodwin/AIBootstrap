// .claude/settings.json
{
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{
        "type": "command",
        "command": "powershell -c \"$i = $env:CLAUDE_TOOL_INPUT; if ($i -match '<<\\s*[A-Z]') { Write-Error 'Heredoc blocked - use the Write tool'; exit 2 }\""
      }]
    }],
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{ "type": "command", "command": "npm run lint --silent || true" }]
    }]
  }
}